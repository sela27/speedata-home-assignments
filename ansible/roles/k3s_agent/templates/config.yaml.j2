# K3s agent config, written by Ansible (roles/k3s_agent). K3s reads it when it starts.

# The K3s server to join, on the Node network.
server: https://{{ cp_address }}:6443

# Use the Node network, not the Uplink (eth0): the node's address, and the NIC
# flannel carries pod traffic on. scripts/1-vms.ps1 names that NIC skywatch0.
# ansible_host is this worker's Node network address (inventory.yml).
node-ip: {{ ansible_host }}
flannel-iface: skywatch0

# No join token here: the installer hands it to the k3s-agent service (see tasks/main.yml).
