# K3s server config, written by Ansible (roles/k3s_server). K3s reads it when it starts.

# Use the Node network, not the Uplink (eth0): the node's address, and the NIC
# flannel carries pod traffic on. scripts/1-vms.ps1 names that NIC skywatch0.
node-ip: {{ cp_address }}
flannel-iface: skywatch0

# The API server certificate must be valid for the address the host's kubeconfig uses.
tls-san:
  - {{ cp_address }}

# No application workloads on the control plane.
node-taint:
  - node-role.kubernetes.io/control-plane:NoSchedule
